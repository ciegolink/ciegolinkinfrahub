# Public address of the hub (exactly as typed in the browser, no trailing slash)
PUBLIC_URL=https://hub.example.com
# Hostname only - used by the optional Caddy profile for the Let's Encrypt certificate
PUBLIC_HOST=hub.example.com
# Shared secret hub <-> SSH gateway, at least 32 characters:  openssl rand -hex 32
GATEWAY_SECRET=
TZ=Europe/Zurich
# Host port for your own reverse proxy (bound to 127.0.0.1 only)
HUB_PORT=18438
SOFTWARE_MAX_MB=2048
# First administrator, created automatically on the very first start only.
# Leave the password empty to get a random one in "docker compose logs hub".
# Either way: own password and 2FA are forced at the first sign-in.
INFRA_ADMIN_USER=admin
INFRA_ADMIN_PASSWORD=
