[Unit]
Description=CiegoLink Infrastructure Hub SSH gateway
After=network-online.target
Wants=network-online.target

[Service]
User=ciegolinkinfrahub-ssh
Group=ciegolinkinfrahub-ssh
WorkingDirectory=@DIR@
EnvironmentFile=@DIR@/gateway.env
Environment=HOME=@DIR@/state
ExecStart=@DIR@/venv/bin/python @DIR@/gateway.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=@DIR@/state
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
